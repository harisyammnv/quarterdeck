{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's own commands, event listening and window dragging. No shell, file system, dialog or network permission.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-app-info",
    "allow-fleet-view",
    "allow-home-pick",
    "allow-memory-list",
    "allow-memory-read",
    "allow-memory-search",
    "allow-refresh-fleet",
    "allow-send-note",
    "allow-skill-read",
    "allow-skills-list",
    "allow-task-pr-open",
    "allow-url-open",
    "allow-view-rendered"
  ]
}
