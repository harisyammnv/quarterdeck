{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's own commands, event listening and window dragging. No shell, file system, dialog or network permission.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-app-info",
    "allow-board-view",
    "allow-container-inspect",
    "allow-container-logs",
    "allow-container-stats",
    "allow-containers-list",
    "allow-containers-status",
    "allow-fleet-view",
    "allow-home-pick",
    "allow-kiri-open",
    "allow-memory-list",
    "allow-memory-read",
    "allow-memory-search",
    "allow-orca-focus",
    "allow-project-icon",
    "allow-projects-view",
    "allow-refresh-fleet",
    "allow-report-history",
    "allow-report-read",
    "allow-reports-list",
    "allow-send-note",
    "allow-skill-read",
    "allow-skills-list",
    "allow-task-pr-open",
    "allow-terminal-tail",
    "allow-url-open",
    "allow-view-rendered"
  ]
}
