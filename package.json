{
  "name": "quarterdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "tsc -p ui/tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
    "preview": "vite preview --config ui/vite.config.ts",
    "typecheck": "tsc -p ui/tsconfig.json --noEmit",
    "lint": "eslint ui",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --debug",
    "check": "node scripts/gen-tokens.mjs --check && pnpm typecheck && pnpm lint && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "tokens": "node scripts/gen-tokens.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "~2.1.10",
    "@tauri-apps/api": "~2.12.5",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "2.1.1",
    "@tauri-apps/cli": "~2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
